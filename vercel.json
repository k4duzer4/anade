{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "bindings": [{ "type": "service", "service": "api", "format": "url", "env": "API_ORIGIN" }]
    },
    "api": {
      "root": "apps/api",
      "framework": "express",
      "entrypoint": "app.js"
    }
  },
  "rewrites": [
    { "source": "/", "destination": { "service": "web", "path": "/" } },
    { "source": "/api/:path*", "destination": { "service": "api" } },
    { "source": "/auth/:path*", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
