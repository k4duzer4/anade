{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "anade-api",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat", "enable_nodejs_http_server_modules"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "NODE_ENV": "production",
    "APP_ORIGIN": "https://anade.example.workers.dev",
    "DISCORD_CLIENT_ID": "1562181914998341714",
    "DISCORD_GUILD_ID": "1559550956322951270",
    "DISCORD_MEMBER_ROLE_ID": "1559710512722219069",
    "DISCORD_ADMIN_ROLE_ID": "",
  },
  "triggers": { "crons": ["0 */6 * * *"] },
}
